{
  "name": "ocr-text-recognition-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Automated checks for the OCR Text Recognition Chrome extension",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --pretty false",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "check": "npm run version:check && npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "package": "node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "eslint": "^9.39.1",
    "typescript": "^7.0.2"
  }
}
